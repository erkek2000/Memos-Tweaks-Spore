key parent spacetools~!ToolTemplate.prop
string16 description "Cargo Upgrade"
int32 spaceToolBuyCost 2000
key spaceToolContext passive
texts spaceToolDescription
	(spacegame_tools!0xeba16d0d) "Large Cargo Hold"
end
texts spaceToolDetailDescription
	(kisutweaks!0x00000092) "Increase your spaceship's cargo capacity."
end
key spaceToolImageID ufotools~!spg_main_cargoupgrade4.png
texts spaceToolLockedDescription
	(spacegame_tools!0xa0bb7099) "Requires ~commodity_requirements~"
end
float spaceToolMaxRange 1
key spaceToolType CargoSlots
