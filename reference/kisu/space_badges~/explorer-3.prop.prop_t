texts badgeCardDescription
	(spacegame_badges!0x7d9b3e0b) "You need to explore ~badge_left~ more Solar Systems. ~badge_count~/~badge_needed~"
end
texts badgeDescriptionString
	(spacegame_badges!0xcd9efc1b) "You've explored ~badge_progress~ Solar Systems."
end
uint32 badgeEffectID 0x39ccd2cf
texts badgeGroup
	(spacegame_badges!0x1f0f9c03) "Explorer"
end
texts badgeHintAction
	(spacegame_badges!0x60fce005) "Explore ~badge_needed~ Solar Systems to earn the Explorer 3 badge.~badge_unlocks~"
end
key badgeLockedImageID spg_badges~!spg_explorer_00.png
texts badgeName
	(spacegame_badges!0x043b3f82) "Explorer 3"
end
int32 badgePointValue 6
key badgeReplacesBadge explorer-2
int32 badgeReqStarsExplored 50
keys badgeRequirementList
	badgeReqStarsExplored
end
texts badgeUnlockString
	(spacegame_badges!0x043b3f83) "You've earned the Explorer 3 badge."
end
key badgeUnlockedImageID spg_badges~!spg_explorer_03.png
