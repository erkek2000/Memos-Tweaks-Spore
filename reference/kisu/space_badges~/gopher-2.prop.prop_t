	(spacegame_badges!0x71ec2c91) "Gopher"
end
texts badgeHintAction
	(spacegame_badges!0xaf4d229a) "Complete ~badge_needed~ Delivery Missions to earn the Gopher 2 badge.~badge_unlocks~"
end
