texts badgeCardDescription
	(spacegame_badges!0x4b9a308e) "You need to complete ~badge_left~ more Missions. ~badge_count~/~badge_needed~"
end
texts badgeDescriptionString
	(spacegame_badges!0xaef0b81f) "You've completed ~badge_progress~ Missions."
end
uint32 badgeEffectID 0x0f85c95f
texts badgeGroup
	(spacegame_badges!0xcdab6def) "Missionista"
end
texts badgeHintAction
	(spacegame_badges!0xd4f5aa1b) "Complete ~badge_needed~ Missions to earn the Missionista 5 badge.~badge_unlocks~"
end
key badgeLockedImageID spg_badges~!spg_missionista_00.png
texts badgeName
	(spacegame_badges!0x0594b8e8) "Missionista 5"
end
int32 badgePointValue 10
key badgeReplacesBadge missionista-4
int32 badgeReqMissionsComplete 30
keys badgeRequirementList
	badgeReqMissionsComplete
end
texts badgeUnlockString
	(spacegame_badges!0x0594c8c9) "You've earned the Missionista 5 badge."
end
key badgeUnlockedImageID spg_badges~!spg_missionista_05.png
