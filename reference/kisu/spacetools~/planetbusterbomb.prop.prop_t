key parent spacetools~!ToolTemplate.prop
string16 description "Planet Buster Bomb"
int32 spaceToolAmmoUsedPerShot 1
int32 spaceToolBuyCost 5000
key spaceToolContext planet
float spaceToolDamageArea 200
texts spaceToolDescription
	(spacegame_tools!0xdcf0cdb9) "Planet Buster"
end
texts spaceToolDetailDescription
	(spacegame_tools!0xd6dd32f8) "Destroys an entire planet. Feared by all.  BIG BADDA BOOM."
end
float spaceToolDetectableRange 2000
bool spaceToolDisableOn201Ruins true
bool spaceToolDisableOnSaveGames true
key spaceToolImageID ufotools~!spg_combat_planetbuster.png
int32 spaceToolInitialAmmoCount 5
texts spaceToolLockedDescription
	(spacegame_tools!0xa0bb7099) "Requires ~commodity_requirements~"
end
int32 spaceToolMaxAmmoCount 99
float spaceToolMaxDamage 10000
float spaceToolMaxRange -1
float spaceToolMinDamage 10000
key spaceToolPanelKey CombatConsumablePanel
float spaceToolRechargeRate 15
key spaceToolStrategy DefaultProjectile
key spaceToolType weapon
bool spaceToolUsesAmmo true
bool toolDeselectsAfterUse true
float toolGalacticRelationshipDelta -4
float toolGalacticRelationshipRadius 10
float toolHitAirAtmosphereVelocity -0.2
float toolHitAirTemperatureVelocity 0.15
float toolHitAirWaterVelocity -0.02
float toolHitCombatantAtmosphereVelocity 0.2
