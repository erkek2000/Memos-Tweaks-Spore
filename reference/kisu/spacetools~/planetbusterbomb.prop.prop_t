float toolHitGroundTemperatureVelocity 0.15
float toolHitGroundWaterVelocity -0.02
float toolHitWaterAtmosphereVelocity -0.2
key toolHitWaterEffectID 0x26A2EC29
float toolHitWaterTemperatureVelocity 0.15
float toolHitWaterWaterVelocity -0.02
int32 toolMilitaryRewardCount 2
key toolMuzzleEffectID SG_pulse_weapon_muzzle
bool toolPreventsPlanetExit true
key toolProjectileEffectID SG_antimatter_weapon
float toolProjectileExplosionExpansionRate 1
float toolProjectileSpeed 150
float toolProjectileTimeOut 250
float toolRelationshipDelta -20
int32s toolTargetFlags
	hash(animal)
	hash(citizen)
	hash(turret)
	hash(city)
	hash(building)
	hash(world)
	hash(colonyobject)
end
