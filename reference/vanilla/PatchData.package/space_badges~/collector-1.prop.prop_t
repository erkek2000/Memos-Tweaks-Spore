texts badgeCardDescription
	(spacegame_badges!0x243daffc) "You need to collect ~badge_left~ more Artifacts. ~badge_count~/~badge_needed~"
end
texts badgeDescriptionString
	(spacegame_badges!0xa40cbd6d) "You've collected ~badge_progress~ Artifacts."
end
uint32 badgeEffectID 0x17f1e2aa
texts badgeGroup
	(spacegame_badges!0xb9b37965) "Collector"
end
texts badgeHintAction
	(spacegame_badges!0xa0379b35) "Collect ~badge_needed~ Artifacts to earn the Collector 1 badge.~badge_unlocks~"
end
key badgeLockedImageID spg_badges~!spg_collector_00.png
texts badgeName
	(spacegame_badges!0x043b3f6a) "Collector 1"
end
int32 badgePointValue 2
