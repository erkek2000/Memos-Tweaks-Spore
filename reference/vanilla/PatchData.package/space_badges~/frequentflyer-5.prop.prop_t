	(spacegame_badges!0xfaa2bbf6) "Frequent Flyer"
end
texts badgeHintAction
	(spacegame_badges!0x455083cc) "Fly between ~badge_needed~ Solar Systems to earn the Frequent Flyer 5 badge.~badge_unlocks~"
end
