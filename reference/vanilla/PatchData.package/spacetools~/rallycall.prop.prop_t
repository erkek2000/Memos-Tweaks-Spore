key parent spacetools~!ToolTemplate.prop
string16 description "Rally Call"
key spaceToolContext planet
texts spaceToolDescription
	(spacegame_tools!0xad6c6eec) "Rally Call"
end
texts spaceToolDetailDescription
	(spacegame_tools!0x84fd3b8d) "Rally's your ally spaceships, momentarily increases the damage they inflict"
end
bool spaceToolDisableOnHomeworld false
float spaceToolEnergyCost 30
key spaceToolImageID ufotools~!spg_combat_rallycall.png
texts spaceToolLockedDescription
	(spacegame_tools!0xa0bb7099) "Requires ~commodity_requirements~"
end
float spaceToolMaxDamage 2
float spaceToolMaxRange -1
float spaceToolMinDamage 0
key spaceToolPanelKey CombatAbilityPanel
float spaceToolRechargeRate 60
key spaceToolStrategy rallycall
key spaceToolType special
bool toolDeselectsAfterUse true
bool toolUseOnActivate true