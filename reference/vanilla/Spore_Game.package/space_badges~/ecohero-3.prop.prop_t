texts badgeCardDescription
	(spacegame_badges!0x5ca496a3) "You need to avert ~badge_left~ more Eco Disasters. ~badge_count~/~badge_needed~"
end
texts badgeDescriptionString
	(spacegame_badges!0x3631cc33) "You've averted ~badge_progress~ Eco Disasters."
end
uint32 badgeEffectID 0x2f6dbf2f
texts badgeGroup
	(spacegame_badges!0x9e20a5eb) "Eco Hero"
end
texts badgeHintAction
	(spacegame_badges!0x0863a02d) "Avert ~badge_needed~ Eco Disasters to earn the Eco Hero 3 badge.~badge_unlocks~"
end
key badgeLockedImageID spg_badges~!spg_ecohero_00.png
texts badgeName
	(spacegame_badges!0x0594b7f9) "Eco Hero 3"
end
int32 badgePointValue 6
key badgeReplacesBadge ecohero-2
int32 badgeReqEcoDisasterMissionsComplete 10
