	(spacegame_badges!0xfaa2bbf6) "Frequent Flyer"
end
texts badgeHintAction
	(spacegame_badges!0x4e252f1b) "Fly between ~badge_needed~ Solar Systems to earn the Frequent Flyer 2 badge.~badge_unlocks~"
end
