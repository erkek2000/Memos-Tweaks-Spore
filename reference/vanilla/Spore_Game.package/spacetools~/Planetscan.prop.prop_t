key parent spacetools~!ToolTemplate.prop
string16 description "Planet Scan"
int32 spaceToolAmmoUsedPerShot 1
int32 spaceToolBuyCost 30
key spaceToolContext planet
texts spaceToolDescription
	(spacegame_tools!0xc9433e6d) "Planet Scan"
end
texts spaceToolDetailDescription
	(spacegame_tools!0x6fd8772c) "Use on a planet to scan all the plants and animals."
end
bool spaceToolDisableOn201Ruins true
bool spaceToolDisableOnHomeworld false
bool spaceToolDisableOnSaveGames false
key spaceToolImageID ufotools~!spg_main_planetscan.png
int32 spaceToolInitialAmmoCount 2
