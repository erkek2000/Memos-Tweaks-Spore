key parent spacetools~!ToolTemplate.prop
string16 description "Interstellar Drive 3"
int32 spaceToolBuyCost 2000
key spaceToolContext passive
texts spaceToolDescription
	(spacegame_tools!0xd1160a0e) "Interstellar Drive 3"
end
texts spaceToolDetailDescription
	(spacegame_tools!0x9f22e5e2) "Increases your spaceship's travel range."
end
float spaceToolDetectableRange 20
key spaceToolImageID ufotools~!spg_main_interstellardrive3.png
texts spaceToolLockedDescription
	(spacegame_tools!0xa0bb7099) "Requires ~commodity_requirements~"
end
float spaceToolMaxRange 8
key spaceToolType other
key spaceToolUpgradeFile interstellardrive_upgrade1.prop