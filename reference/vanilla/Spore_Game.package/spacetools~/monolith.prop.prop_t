key parent spacetools~!ToolTemplate.prop
string16 description "Monolith"
int32 monolithCircleRadius 10
float monolithWorshipTimeSeconds 7
int32 spaceToolAmmoUsedPerShot 1
string16 spaceToolArtifactModel "SG_monolith"
int32 spaceToolBuyCost 15
key spaceToolContext planet
texts spaceToolDescription
	(spacegame_tools!0xcf45829a) "Monolith"
end
texts spaceToolDetailDescription
	(spacegame_tools!0x870c8c43) "Place on a tribal or civilized planet to uplift the species on this planet."
end
bool spaceToolDisableOn201Ruins true
bool spaceToolDisableOnSaveGames true
key spaceToolImageID ufotools~!spg_social_monolith.png
int32 spaceToolInitialAmmoCount 1
texts spaceToolLockedDescription
	(spacegame_tools!0xa0bb7099) "Requires ~commodity_requirements~"
end
int32 spaceToolMaxAmmoCount 99
int32 spaceToolMaxDiscoveredAmmo 1
float spaceToolMaxRange 300
int32 spaceToolMinDiscoveredAmmo 1
key spaceToolPanelKey SocialConsumablePanel
float spaceToolRechargeRate 5
key spaceToolStrategy DefaultProjectile
key spaceToolType special
bool spaceToolUsesAmmo true
bool toolDeselectsAfterUse true
key toolDiscoverableRarity SuperRare
bool toolDoActionPostEffect true
key toolHitGroundEffectID SG_ufo_monolith_projectile_explosion
key toolHitWaterEffectID SG_ufo_monolith_projectile_explosion
int32 toolMeaningOfLifeRewardCount 0
key toolMuzzleEffectID SG_ufo_monolith_muzzle
bool toolPreventsPlanetExit true
key toolProjectileEffectID SG_ufo_monolith_projectile
float toolProjectileExplosionExpansionRate 5000
bool toolProjectilePassThrough true
float toolProjectileSpeed 50
float toolProjectileTimeOut 15
int32s toolTargetFlags
	hash(animal)
	hash(citizen)
	hash(turret)
	hash(city)
	hash(building)
	hash(world)
end
texts toolTargetFlagsFailMessage
	(spacegame_tools!0xfdd8cc2a) "You must choose a valid ground target to use this tool."
end